# ===== 运行环境 =====
.venv/
.build-venv/

# ===== Python 编译产物 =====
__pycache__/
*.py[cod]

# ===== 测试/覆盖率产物 =====
.pytest_cache/
.coverage
htmlcov/

# ===== 用户本地数据 =====
config.json
downloads/
logs/

# ===== 打包产物 =====
build/
dist/

# ===== 临时/媒体文件 =====
*.part
*.tmp
*.log
*.mp3
*.wav
*.ogg

# ===== 工具输出 =====
smoke-report*.json
captured-page*.html

# ===== IDE 配置 =====
.idea/

# ===== 发布产物 =====
MANIFEST.sha256

# ===== docs/ 可添加白名单：默认全部忽略=====
docs/

# Deliberate offline test assets, not user downloads.
!tests/fixtures/**/*.mp3
!tests/fixtures/**/*.ogg
!tests/fixtures/**/*.part
